# The Saints Club — mail settings (template: copy to .env and fill in)
# Mirror these into Vercel → the-saints-club → Settings → Environment Variables (Production)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="The Saints Club <you@gmail.com>"
MAIL_TO=you@gmail.com
MAIL_REPLY_TO=you@gmail.com
SITE_URL=https://the-saints-club.vercel.app
